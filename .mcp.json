{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--isolated",
        "--executable-path",
        "/opt/pw-browsers/chromium",
        "--viewport-size",
        "1440,900"
      ]
    }
  }
}
